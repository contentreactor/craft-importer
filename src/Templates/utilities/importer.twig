{% import "_includes/forms" as forms %}
{% set filePath = craft.app.path.configPath ~ '/craft-importer.php' %}
{% import "codeeditor/codeEditor" as codeEditor %}

{% set fileContents = null %}
{% set success = null %}

{% if filePath is defined and filePath %}
	{% if file_exists(filePath) %}
		{% set fileContents = file_get_contents(filePath) %}
	{% endif %}
{% endif %}

{# -- Handle form submission -- #}
{% if craft.app.request.getIsPost() %}
	{% set newContent = craft.app.request.getBodyParam('codeField') %}
	{% if newContent is not null %}
		{% set bytesWritten = file_put_contents(filePath, newContent) %}
		{% if bytesWritten %}
			{% set success = "✅ File saved successfully!" %}
		{% else %}
			{% set success = "❌ Failed to save the file." %}
		{% endif %}
	{% endif %}
{% endif %}

{# -- The editing form -- #}
<form method="post">
	{{ csrfInput() }}
	{% set config = {
		id: 'codeField',
		name: 'codeField',
		describedBy: 'Store config here',
		placeholder: "<?php\n\nreturn [\n];\n",
		required: true,
		first: true,
		value: fileContents,
	} %}
	{{ codeEditor.textareaField(
		config,
		"CodeEditor",
		{
			theme: 'vs-dark',
			language: 'php',
			fontSize: 14,
			lineNumbers: 'on',
			lineDecorationsWidth: 6,
			folding: true,
		},
		# codeEditorOptions,
	) }}
	<button type="submit" style="margin-top:10px;">Save File</button>
</form>

{% if success %}
	<p>{{ success }}</p>
{% endif %}
